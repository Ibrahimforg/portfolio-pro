# Configuration des variables d'environnement pour Portfolio Pro
# Copiez ce fichier vers .env.local et remplissez les valeurs réelles

# Supabase Configuration
# Obtenez ces valeurs depuis votre dashboard Supabase: https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Optionnel: Configuration Supabase Service Role (pour les opérations admin)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Optionnel: Configuration Analytics
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Optionnel: Configuration Email (pour les notifications)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-email@example.com
# SMTP_PASS=your-password

# Optionnel: Configuration Storage
# NEXT_PUBLIC_STORAGE_URL=https://your-project.supabase.co/storage/v1

# Instructions:
# 1. Créez un compte Supabase: https://supabase.com
# 2. Créez un nouveau projet
# 3. Allez dans Settings > API
# 4. Copiez l'URL et la clé anon
# 5. Collez-les dans ce fichier
# 6. Renommez ce fichier en .env.local
# 7. Redémarrez le serveur de développement
